<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AFG.Shared.ViewModels"
             xmlns:views="using:AFG.Shared.Views"
             xmlns:controls="using:AFG.Shared.Controls"
             xmlns:models="using:AFG.Shared.Models"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="AFG.Shared.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- 頂部工具列 (Toolbar) -->
        <Border Grid.Row="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto">
                <!-- 檔案與專案操作 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding NewDocumentCommand}" ToolTip.Tip="建立新表單" Content="新增" />
                    <Button Command="{Binding OpenDocumentCommand}" ToolTip.Tip="開啟 AFG 專案檔" Content="開啟" />
                    <Button Command="{Binding SaveDocumentCommand}" ToolTip.Tip="儲存 AFG 專案檔" Content="儲存" />
                    <Button Command="{Binding ExportFullProjectCommand}" ToolTip.Tip="匯出完整跨平台 Avalonia 方案" Content="匯出整包專案" />
                </StackPanel>

                <!-- 畫布編輯與控制項工具 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                    <Button Command="{Binding AddSelectedToolboxItemCommand}" ToolTip.Tip="加入選取的工具箱控制項" Content="加入控制項" />
                    <Button Command="{Binding DeleteSelectedNodeCommand}" ToolTip.Tip="刪除選取的控制項" Content="刪除" />
                    <ToggleButton IsChecked="{Binding Canvas.SnapToGrid, Mode=TwoWay}" ToolTip.Tip="開啟/關閉網格吸附" Content="網格吸附" />
                </StackPanel>

                <!-- 裝置解析度/長寬比與跨平台選項 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="解析度/比例:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Canvas.AvailablePresets}"
                              SelectedItem="{Binding Canvas.SelectedPreset, Mode=TwoWay}"
                              Width="220"
                              PlaceholderText="選擇裝置解析度與比例">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:CanvasPreset">
                                <TextBlock Text="{Binding}" FontSize="12" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox IsChecked="{Binding Canvas.IncludeMobileProject, Mode=TwoWay}"
                              Content="包含行動端 (.Android)"
                              ToolTip.Tip="勾選時將自動生成 .Android 跨平台專案"
                              FontSize="12" />
                </StackPanel>

                <!-- 右側代碼生成操作 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding CopyViewCodeCommand}" Content="複製 View C#" />
                    <Button Command="{Binding CopyVmCodeCommand}" Content="複製 ViewModel C#" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中間主工作區 -->
        <Grid Grid.Row="1" ColumnDefinitions="260, 4, *, 4, 320">
            <!-- 左側邊欄：工具箱與 DOM 樹 -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0">
                <TabControl>
                    <TabItem Header="工具箱">
                        <views:ToolboxView DataContext="{Binding Toolbox}" />
                    </TabItem>
                    <TabItem Header="元件樹">
                        <views:VisualTreeExplorerView DataContext="{Binding VisualTree}" />
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Background="#27272A" ResizeDirection="Columns" />

            <!-- 中央區塊：設計畫布與即時程式碼預覽 -->
            <Grid Grid.Column="2" RowDefinitions="*, 4, 220">
                <!-- 視覺畫布區 (ScrollViewer) -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#09090B">
                    <Border Margin="24"
                            BoxShadow="0 10 30 0 #40000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="#3F3F46"
                            BorderThickness="1">
                        <controls:DesignCanvas x:Name="MainDesignCanvas"
                                               Width="{Binding Canvas.Document.CanvasWidth}"
                                               Height="{Binding Canvas.Document.CanvasHeight}"
                                               ViewModel="{Binding Canvas}" />
                    </Border>
                </ScrollViewer>

                <GridSplitter Grid.Row="1" Background="#27272A" ResizeDirection="Rows" />

                <!-- 底部即時程式碼預覽區 -->
                <Border Grid.Row="2" Background="#18181B">
                    <TabControl>
                        <TabItem Header="View (C# Markup)">
                            <TextBox Text="{Binding GeneratedViewCode}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="#121214"
                                     Foreground="#E4E4E7" />
                        </TabItem>
                        <TabItem Header="ViewModel (CommunityToolkit.Mvvm)">
                            <TextBox Text="{Binding GeneratedVmCode}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="#121214"
                                     Foreground="#E4E4E7" />
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Background="#27272A" ResizeDirection="Columns" />

            <!-- 右側邊欄：完整屬性與事件檢查器 (Inspector) -->
            <Border Grid.Column="4" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,0,0">
                <views:InspectorView DataContext="{Binding Inspector}" />
            </Border>
        </Grid>

        <!-- 底部狀態列 (Status Bar) -->
        <Border Grid.Row="2"
                Background="#09090B"
                BorderBrush="#27272A"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Canvas.SelectedNode.Id, StringFormat='選取節點: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                    <TextBlock Text="{Binding ValidationErrorCount, StringFormat='語法診斷問題: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Avalonia Form Generator (AFG) - Pure C# Declarative UI Engine (.NET 10)"
                           FontSize="11"
                           Foreground="#71717A" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
