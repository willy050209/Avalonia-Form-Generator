<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AFG.Shared.ViewModels"
             xmlns:views="using:AFG.Shared.Views"
             xmlns:controls="using:AFG.Shared.Controls"
             xmlns:models="using:AFG.Shared.Models"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="AFG.Shared.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportFullProjectCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- 頂部選單列 (Menu Bar) -->
        <Border Grid.Row="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1">
            <Menu Background="#18181B">
                <MenuItem Header="檔案(_F)">
                    <MenuItem Header="新增表單" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                    <MenuItem Header="開啟專案..." Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                    <MenuItem Header="儲存專案..." Command="{Binding SaveDocumentCommand}" InputGesture="Ctrl+S" />
                    <Separator />
                    <MenuItem Header="匯出完整跨平台專案..." Command="{Binding ExportFullProjectCommand}" InputGesture="Ctrl+Shift+E" />
                </MenuItem>
                <MenuItem Header="編輯(_E)">
                    <MenuItem Header="復原" Command="{Binding UndoCommand}" IsEnabled="{Binding Canvas.History.CanUndo}" InputGesture="Ctrl+Z" />
                    <MenuItem Header="重做" Command="{Binding RedoCommand}" IsEnabled="{Binding Canvas.History.CanRedo}" InputGesture="Ctrl+Y" />
                    <Separator />
                    <MenuItem Header="複製節點" Command="{Binding CopyNodesCommand}" InputGesture="Ctrl+C" />
                    <MenuItem Header="貼上節點" Command="{Binding PasteNodesCommand}" InputGesture="Ctrl+V" />
                    <MenuItem Header="刪除選取" Command="{Binding DeleteSelectedNodeCommand}" InputGesture="Delete" />
                </MenuItem>
                <MenuItem Header="排版對齊(_A)">
                    <MenuItem Header="靠左對齊" Command="{Binding AlignLeftCommand}" />
                    <MenuItem Header="水平置中" Command="{Binding AlignCenterCommand}" />
                    <MenuItem Header="靠右對齊" Command="{Binding AlignRightCommand}" />
                    <Separator />
                    <MenuItem Header="頂部對齊" Command="{Binding AlignTopCommand}" />
                    <MenuItem Header="垂直置中" Command="{Binding AlignMiddleCommand}" />
                    <MenuItem Header="底部對齊" Command="{Binding AlignBottomCommand}" />
                    <Separator />
                    <MenuItem Header="水平均勻分佈" Command="{Binding DistributeHorizontalCommand}" />
                    <MenuItem Header="垂直均勻分佈" Command="{Binding DistributeVerticalCommand}" />
                </MenuItem>
                <MenuItem Header="檢視(_V)">
                    <MenuItem Header="工具箱 / 元件樹" Command="{Binding ToggleLeftPanelCommand}" />
                    <MenuItem Header="即時程式碼預覽" Command="{Binding ToggleCodePanelCommand}" />
                    <MenuItem Header="屬性檢查器" Command="{Binding ToggleRightPanelCommand}" />
                    <Separator />
                    <MenuItem Header="複製 View C# Markup" Command="{Binding CopyViewCodeCommand}" />
                    <MenuItem Header="複製 ViewModel C#" Command="{Binding CopyVmCodeCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 頂部工具列 (精簡乾淨：裝置規格、畫布尺寸、吸附與工作區切換) -->
        <Border Grid.Row="1"
                Background="#202024"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid ColumnDefinitions="*, Auto">
                <!-- 工具列主體：裝置規格、畫布寬高、專案設定與吸附 (支援橫向自適應) -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- 1. 裝置規格與畫布寬高群組 -->
                        <TextBlock Text="裝置規格:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding Canvas.AvailablePresets}"
                                  SelectedItem="{Binding Canvas.SelectedPreset, Mode=TwoWay}"
                                  Width="190"
                                  PlaceholderText="選擇裝置解析度">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CanvasPreset">
                                    <TextBlock Text="{Binding}" FontSize="11" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="寬:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="11" />
                        <NumericUpDown Value="{Binding Canvas.CanvasWidth, Mode=TwoWay}"
                                       Minimum="200" Maximum="4000"
                                       Width="110"
                                       FormatString="0"
                                       ToolTip.Tip="自訂畫布寬度 (像素)" />

                        <TextBlock Text="高:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="11" />
                        <NumericUpDown Value="{Binding Canvas.CanvasHeight, Mode=TwoWay}"
                                       Minimum="200" Maximum="4000"
                                       Width="110"
                                       FormatString="0"
                                       ToolTip.Tip="自訂畫布高度 (像素)" />

                        <Rectangle Width="1" Height="16" Fill="#3F3F46" Margin="4,0" />

                        <!-- 2. 專案匯出與跨平台設定群組 -->
                        <TextBlock Text="專案名稱:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="11" />
                        <TextBox Text="{Binding Canvas.ExportProjectName, Mode=TwoWay}"
                                 Width="120"
                                 FontSize="11"
                                 PlaceholderText="自訂專案名稱"
                                 ToolTip.Tip="自訂匯出方案與專案名稱 (.slnx, .Shared, .Desktop, .Android)" />

                        <CheckBox IsChecked="{Binding Canvas.IncludeMobileProject, Mode=TwoWay}"
                                  Content="行動端 (.Android)"
                                  ToolTip.Tip="勾選時將自動生成 .Android 跨平台專案"
                                  FontSize="11" />

                        <CheckBox IsChecked="{Binding Canvas.IncludeLicense, Mode=TwoWay}"
                                  Content="授權 (LICENSE)"
                                  ToolTip.Tip="勾選時將在匯出專案根目錄自動生成 MIT LICENSE 授權檔案"
                                  FontSize="11" />

                        <Rectangle Width="1" Height="16" Fill="#3F3F46" Margin="4,0" />

                        <!-- 3. 編輯輔助 -->
                        <ToggleButton IsChecked="{Binding Canvas.SnapToGrid, Mode=TwoWay}" ToolTip.Tip="開啟/關閉網格吸附" Content="網格吸附" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 面板摺疊開關 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsLeftPanelVisible, Mode=TwoWay}" ToolTip.Tip="顯示/隱藏左側工具箱與元件樹" Content="工具箱" />
                    <ToggleButton IsChecked="{Binding IsCodePanelVisible, Mode=TwoWay}" ToolTip.Tip="顯示/隱藏底部程式碼預覽" Content="程式碼" />
                    <ToggleButton IsChecked="{Binding IsRightPanelVisible, Mode=TwoWay}" ToolTip.Tip="顯示/隱藏右側屬性檢查器" Content="屬性欄" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中間主工作區（支援左側、底部、右側面板摺疊展開） -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *, Auto, Auto">
            <!-- 左側邊欄：工具箱與 DOM 樹 -->
            <Border Grid.Column="0"
                    Width="260"
                    IsVisible="{Binding IsLeftPanelVisible}"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="0,0,1,0">
                <TabControl>
                    <TabItem Header="工具箱">
                        <views:ToolboxView DataContext="{Binding Toolbox}" />
                    </TabItem>
                    <TabItem Header="元件樹">
                        <views:VisualTreeExplorerView DataContext="{Binding VisualTree}" />
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          IsVisible="{Binding IsLeftPanelVisible}"
                          Background="#27272A"
                          ResizeDirection="Columns" />

            <!-- 中央區塊：設計畫布與即時程式碼預覽 -->
            <Grid Grid.Column="2" x:Name="CenterGrid" RowDefinitions="*, Auto, Auto">
                <!-- 視覺畫布區 (ScrollViewer) -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#09090B">
                    <Border Margin="24"
                            BoxShadow="0 10 30 0 #40000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="#3F3F46"
                            BorderThickness="1">
                        <controls:DesignCanvas x:Name="MainDesignCanvas"
                                               Width="{Binding Canvas.Document.CanvasWidth}"
                                               Height="{Binding Canvas.Document.CanvasHeight}"
                                               ViewModel="{Binding Canvas}" />
                    </Border>
                </ScrollViewer>

                <GridSplitter Grid.Row="1"
                              Height="4"
                              IsVisible="{Binding IsCodePanelVisible}"
                              Background="#27272A"
                              ResizeDirection="Rows" />

                <!-- 底部即時程式碼預覽區 -->
                <Border Grid.Row="2"
                        Height="240"
                        IsVisible="{Binding IsCodePanelVisible}"
                        Background="#18181B"
                        BorderBrush="#27272A"
                        BorderThickness="0,1,0,0">
                    <TabControl>
                        <TabItem Header="View (C# Markup)">
                            <Grid RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,4">
                                    <Button Content="複製 View 程式碼"
                                            Command="{Binding CopyViewCodeCommand}"
                                            Padding="10,4"
                                            FontSize="11"
                                            Background="#27272A"
                                            Foreground="#E4E4E7" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="#121214"
                                              Padding="12,8">
                                    <SelectableTextBlock x:Name="ViewCodeTextBlock"
                                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                                         FontSize="12"
                                                         LineHeight="20"
                                                         Foreground="#D4D4D4" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="ViewModel (CommunityToolkit.Mvvm)">
                            <Grid RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,4">
                                    <Button Content="複製 ViewModel 程式碼"
                                            Command="{Binding CopyVmCodeCommand}"
                                            Padding="10,4"
                                            FontSize="11"
                                            Background="#27272A"
                                            Foreground="#E4E4E7" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="#121214"
                                              Padding="12,8">
                                    <SelectableTextBlock x:Name="VmCodeTextBlock"
                                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                                         FontSize="12"
                                                         LineHeight="20"
                                                         Foreground="#D4D4D4" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          IsVisible="{Binding IsRightPanelVisible}"
                          Background="#27272A"
                          ResizeDirection="Columns" />

            <!-- 右側邊欄：完整屬性與事件檢查器 (Inspector) -->
            <Border Grid.Column="4"
                    Width="320"
                    IsVisible="{Binding IsRightPanelVisible}"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1,0,0,0">
                <views:InspectorView DataContext="{Binding Inspector}" />
            </Border>
        </Grid>

        <!-- 底部狀態列 (Status Bar) -->
        <Border Grid.Row="3"
                Background="#09090B"
                BorderBrush="#27272A"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Canvas.SelectedNode.Id, StringFormat='選取節點: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                    <TextBlock Text="{Binding ValidationErrorCount, StringFormat='語法診斷問題: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Avalonia Form Generator (AFG) - Pure C# Declarative UI Engine (.NET 10)"
                           FontSize="11"
                           Foreground="#71717A" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
