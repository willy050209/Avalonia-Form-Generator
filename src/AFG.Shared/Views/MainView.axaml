<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AFG.Shared.ViewModels"
             xmlns:views="using:AFG.Shared.Views"
             xmlns:controls="using:AFG.Shared.Controls"
             xmlns:models="using:AFG.Shared.Models"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="AFG.Shared.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- 頂部選單列 (Menu Bar) -->
        <Border Grid.Row="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1">
            <Menu Background="#18181B">
                <MenuItem Header="檔案(_F)">
                    <MenuItem Header="新增表單" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                    <MenuItem Header="開啟專案..." Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                    <MenuItem Header="儲存專案..." Command="{Binding SaveDocumentCommand}" InputGesture="Ctrl+S" />
                    <Separator />
                    <MenuItem Header="匯出完整跨平台專案..." Command="{Binding ExportFullProjectCommand}" />
                </MenuItem>
                <MenuItem Header="編輯(_E)">
                    <MenuItem Header="復原" Command="{Binding UndoCommand}" IsEnabled="{Binding Canvas.History.CanUndo}" InputGesture="Ctrl+Z" />
                    <MenuItem Header="重做" Command="{Binding RedoCommand}" IsEnabled="{Binding Canvas.History.CanRedo}" InputGesture="Ctrl+Y" />
                    <Separator />
                    <MenuItem Header="複製節點" Command="{Binding CopyNodesCommand}" InputGesture="Ctrl+C" />
                    <MenuItem Header="貼上節點" Command="{Binding PasteNodesCommand}" InputGesture="Ctrl+V" />
                    <MenuItem Header="刪除選取" Command="{Binding DeleteSelectedNodeCommand}" InputGesture="Del" />
                </MenuItem>
                <MenuItem Header="排版對齊(_A)">
                    <MenuItem Header="靠左對齊" Command="{Binding AlignLeftCommand}" />
                    <MenuItem Header="水平置中" Command="{Binding AlignCenterCommand}" />
                    <MenuItem Header="靠右對齊" Command="{Binding AlignRightCommand}" />
                    <Separator />
                    <MenuItem Header="頂部對齊" Command="{Binding AlignTopCommand}" />
                    <MenuItem Header="垂直置中" Command="{Binding AlignMiddleCommand}" />
                    <MenuItem Header="底部對齊" Command="{Binding AlignBottomCommand}" />
                    <Separator />
                    <MenuItem Header="水平均勻分佈" Command="{Binding DistributeHorizontalCommand}" />
                    <MenuItem Header="垂直均勻分佈" Command="{Binding DistributeVerticalCommand}" />
                </MenuItem>
                <MenuItem Header="檢視(_V)">
                    <MenuItem Header="工具箱 / 元件樹" Command="{Binding ToggleLeftPanelCommand}" />
                    <MenuItem Header="即時程式碼預覽" Command="{Binding ToggleCodePanelCommand}" />
                    <MenuItem Header="屬性檢查器" Command="{Binding ToggleRightPanelCommand}" />
                    <Separator />
                    <MenuItem Header="複製 View C# Markup" Command="{Binding CopyViewCodeCommand}" />
                    <MenuItem Header="複製 ViewModel C#" Command="{Binding CopyVmCodeCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 頂部工具列 (ToolBar，支援水平自動捲動防溢出) -->
        <Border Grid.Row="1"
                Background="#202024"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 檔案快捷操作 -->
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button Command="{Binding NewDocumentCommand}" ToolTip.Tip="建立新表單 (Ctrl+N)" Content="新增" />
                        <Button Command="{Binding OpenDocumentCommand}" ToolTip.Tip="開啟 AFG 專案檔 (Ctrl+O)" Content="開啟" />
                        <Button Command="{Binding SaveDocumentCommand}" ToolTip.Tip="儲存 AFG 專案檔 (Ctrl+S)" Content="儲存" />
                        <Button Command="{Binding ExportFullProjectCommand}" ToolTip.Tip="匯出完整跨平台 Avalonia 方案" Content="匯出專案" />
                    </StackPanel>

                    <Separator Classes="vertical" Width="1" Height="20" Background="#3F3F46" Margin="2,0" />

                    <!-- 歷史與編輯快捷操作 -->
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button Command="{Binding UndoCommand}"
                                IsEnabled="{Binding Canvas.History.CanUndo}"
                                ToolTip.Tip="復原 (Ctrl + Z)" Content="復原" />
                        <Button Command="{Binding RedoCommand}"
                                IsEnabled="{Binding Canvas.History.CanRedo}"
                                ToolTip.Tip="重做 (Ctrl + Y)" Content="重做" />
                        <Button Command="{Binding CopyNodesCommand}" ToolTip.Tip="複製選取節點 (Ctrl + C)" Content="複製" />
                        <Button Command="{Binding PasteNodesCommand}" ToolTip.Tip="貼上節點 (Ctrl + V)" Content="貼上" />
                        <Button Command="{Binding DeleteSelectedNodeCommand}" ToolTip.Tip="刪除選取的控制項 (Delete)" Content="刪除" />
                    </StackPanel>

                    <Separator Classes="vertical" Width="1" Height="20" Background="#3F3F46" Margin="2,0" />

                    <!-- 對齊與吸附工具列 -->
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button Command="{Binding AlignLeftCommand}" ToolTip.Tip="靠左對齊" Content="左對齊" />
                        <Button Command="{Binding AlignCenterCommand}" ToolTip.Tip="水平置中" Content="水平置中" />
                        <Button Command="{Binding AlignRightCommand}" ToolTip.Tip="靠右對齊" Content="右對齊" />
                        <Button Command="{Binding AlignTopCommand}" ToolTip.Tip="靠頂對齊" Content="頂對齊" />
                        <Button Command="{Binding AlignMiddleCommand}" ToolTip.Tip="垂直置中" Content="垂直置中" />
                        <Button Command="{Binding AlignBottomCommand}" ToolTip.Tip="靠底對齊" Content="底對齊" />
                        <Button Command="{Binding DistributeHorizontalCommand}" ToolTip.Tip="水平均勻分佈" Content="水平均分" />
                        <Button Command="{Binding DistributeVerticalCommand}" ToolTip.Tip="垂直均勻分佈" Content="垂直均分" />
                        <ToggleButton IsChecked="{Binding Canvas.SnapToGrid, Mode=TwoWay}" ToolTip.Tip="開啟/關閉網格吸附" Content="網格吸附" />
                    </StackPanel>

                    <Separator Classes="vertical" Width="1" Height="20" Background="#3F3F46" Margin="2,0" />

                    <!-- 裝置解析度/長寬比與跨平台選項 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="解析度:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding Canvas.AvailablePresets}"
                                  SelectedItem="{Binding Canvas.SelectedPreset, Mode=TwoWay}"
                                  Width="180"
                                  PlaceholderText="選擇裝置解析度">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CanvasPreset">
                                    <TextBlock Text="{Binding}" FontSize="11" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="寬:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="11" />
                        <NumericUpDown Value="{Binding Canvas.CanvasWidth, Mode=TwoWay}"
                                       Minimum="200" Maximum="4000"
                                       Width="85"
                                       FormatString="0"
                                       ToolTip.Tip="自訂畫布寬度 (像素)" />

                        <TextBlock Text="高:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="11" />
                        <NumericUpDown Value="{Binding Canvas.CanvasHeight, Mode=TwoWay}"
                                       Minimum="200" Maximum="4000"
                                       Width="85"
                                       FormatString="0"
                                       ToolTip.Tip="自訂畫布高度 (像素)" />

                        <CheckBox IsChecked="{Binding Canvas.IncludeMobileProject, Mode=TwoWay}"
                                  Content="包含 Android"
                                  ToolTip.Tip="勾選時將自動生成 .Android 跨平台專案"
                                  FontSize="11" />

                        <CheckBox IsChecked="{Binding Canvas.IncludeLicense, Mode=TwoWay}"
                                  Content="包含 LICENSE"
                                  ToolTip.Tip="勾選時將在匯出專案根目錄自動生成 MIT LICENSE 授權檔案"
                                  FontSize="11" />
                    </StackPanel>

                    <Separator Classes="vertical" Width="1" Height="20" Background="#3F3F46" Margin="2,0" />

                    <!-- 面板摺疊與代碼操作 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton IsChecked="{Binding IsLeftPanelVisible, Mode=TwoWay}" ToolTip.Tip="顯示/隱藏左側工具箱與元件樹" Content="工具箱" />
                        <ToggleButton IsChecked="{Binding IsCodePanelVisible, Mode=TwoWay}" ToolTip.Tip="顯示/隱藏底部程式碼預覽" Content="程式碼" />
                        <ToggleButton IsChecked="{Binding IsRightPanelVisible, Mode=TwoWay}" ToolTip.Tip="顯示/隱藏右側屬性檢查器" Content="屬性欄" />
                        <Button Command="{Binding CopyViewCodeCommand}" ToolTip.Tip="複製 View C# Markup" Content="複製 View" />
                        <Button Command="{Binding CopyVmCodeCommand}" ToolTip.Tip="複製 ViewModel C#" Content="複製 VM" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 中間主工作區（支援左側、底部、右側面板摺疊展開） -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *, Auto, Auto">
            <!-- 左側邊欄：工具箱與 DOM 樹 -->
            <Border Grid.Column="0"
                    Width="260"
                    IsVisible="{Binding IsLeftPanelVisible}"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="0,0,1,0">
                <TabControl>
                    <TabItem Header="工具箱">
                        <views:ToolboxView DataContext="{Binding Toolbox}" />
                    </TabItem>
                    <TabItem Header="元件樹">
                        <views:VisualTreeExplorerView DataContext="{Binding VisualTree}" />
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          IsVisible="{Binding IsLeftPanelVisible}"
                          Background="#27272A"
                          ResizeDirection="Columns" />

            <!-- 中央區塊：設計畫布與即時程式碼預覽 -->
            <Grid Grid.Column="2" RowDefinitions="*, Auto, Auto">
                <!-- 視覺畫布區 (ScrollViewer) -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#09090B">
                    <Border Margin="24"
                            BoxShadow="0 10 30 0 #40000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="#3F3F46"
                            BorderThickness="1">
                        <controls:DesignCanvas x:Name="MainDesignCanvas"
                                               Width="{Binding Canvas.Document.CanvasWidth}"
                                               Height="{Binding Canvas.Document.CanvasHeight}"
                                               ViewModel="{Binding Canvas}" />
                    </Border>
                </ScrollViewer>

                <GridSplitter Grid.Row="1"
                              Height="4"
                              IsVisible="{Binding IsCodePanelVisible}"
                              Background="#27272A"
                              ResizeDirection="Rows" />

                <!-- 底部即時程式碼預覽區 -->
                <Border Grid.Row="2"
                        Height="220"
                        IsVisible="{Binding IsCodePanelVisible}"
                        Background="#18181B">
                    <TabControl>
                        <TabItem Header="View (C# Markup)">
                            <TextBox Text="{Binding GeneratedViewCode}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="#121214"
                                     Foreground="#E4E4E7" />
                        </TabItem>
                        <TabItem Header="ViewModel (CommunityToolkit.Mvvm)">
                            <TextBox Text="{Binding GeneratedVmCode}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="#121214"
                                     Foreground="#E4E4E7" />
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          IsVisible="{Binding IsRightPanelVisible}"
                          Background="#27272A"
                          ResizeDirection="Columns" />

            <!-- 右側邊欄：完整屬性與事件檢查器 (Inspector) -->
            <Border Grid.Column="4"
                    Width="320"
                    IsVisible="{Binding IsRightPanelVisible}"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1,0,0,0">
                <views:InspectorView DataContext="{Binding Inspector}" />
            </Border>
        </Grid>

        <!-- 底部狀態列 (Status Bar) -->
        <Border Grid.Row="3"
                Background="#09090B"
                BorderBrush="#27272A"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Canvas.SelectedNode.Id, StringFormat='選取節點: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                    <TextBlock Text="{Binding ValidationErrorCount, StringFormat='語法診斷問題: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Avalonia Form Generator (AFG) - Pure C# Declarative UI Engine (.NET 10)"
                           FontSize="11"
                           Foreground="#71717A" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
