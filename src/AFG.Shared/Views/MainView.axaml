<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AFG.Shared.ViewModels"
             xmlns:views="using:AFG.Shared.Views"
             xmlns:controls="using:AFG.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
             x:Class="AFG.Shared.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- 頂部工具列 (Toolbar) -->
        <Border Grid.Row="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                <!-- 檔案與專案操作 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding NewDocumentCommand}" ToolTip.Tip="建立新表單">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📄" />
                            <TextBlock Text="新增" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenDocumentCommand}" ToolTip.Tip="開啟 AFG 專案檔">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📂" />
                            <TextBlock Text="開啟" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveDocumentCommand}" ToolTip.Tip="儲存 AFG 專案檔">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="💾" />
                            <TextBlock Text="儲存" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 畫布編輯與控制項工具 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                    <Button Command="{Binding AddSelectedToolboxItemCommand}" ToolTip.Tip="加入選取的工具箱控制項">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="➕" />
                            <TextBlock Text="加入控制項" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteSelectedNodeCommand}" ToolTip.Tip="刪除選取的控制項">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🗑️" />
                            <TextBlock Text="刪除" />
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding Canvas.SnapToGrid, Mode=TwoWay}" ToolTip.Tip="開啟/關閉網格吸附">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🧲" />
                            <TextBlock Text="網格吸附" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- 右側代碼生成操作 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding CopyViewCodeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📋" />
                            <TextBlock Text="複製 View C#" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopyVmCodeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📋" />
                            <TextBlock Text="複製 ViewModel C#" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中間主工作區 -->
        <Grid Grid.Row="1" ColumnDefinitions="260, 4, *, 4, 300">
            <!-- 左側邊欄：工具箱與 DOM 樹 -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0">
                <TabControl>
                    <TabItem Header="🧰 工具箱">
                        <views:ToolboxView DataContext="{Binding Toolbox}" />
                    </TabItem>
                    <TabItem Header="🌳 DOM 元件樹">
                        <views:VisualTreeExplorerView DataContext="{Binding VisualTree}" />
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Background="#27272A" ResizeDirection="Columns" />

            <!-- 中央區塊：設計畫布與即時程式碼預覽 -->
            <Grid Grid.Column="2" RowDefinitions="*, 4, 220">
                <!-- 視覺畫布區 (ScrollViewer) -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#09090B">
                    <Border Margin="24"
                            BoxShadow="0 10 30 0 #40000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="#3F3F46"
                            BorderThickness="1">
                        <controls:DesignCanvas x:Name="MainDesignCanvas"
                                               Width="{Binding Canvas.Document.CanvasWidth}"
                                               Height="{Binding Canvas.Document.CanvasHeight}"
                                               ViewModel="{Binding Canvas}" />
                    </Border>
                </ScrollViewer>

                <GridSplitter Grid.Row="1" Background="#27272A" ResizeDirection="Rows" />

                <!-- 底部即時程式碼預覽區 -->
                <Border Grid.Row="2" Background="#18181B">
                    <TabControl>
                        <TabItem Header="📄 View (C# Markup)">
                            <TextBox Text="{Binding GeneratedViewCode}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="#121214"
                                     Foreground="#E4E4E7" />
                        </TabItem>
                        <TabItem Header="⚙️ ViewModel (CommunityToolkit.Mvvm)">
                            <TextBox Text="{Binding GeneratedVmCode}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="#121214"
                                     Foreground="#E4E4E7" />
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Background="#27272A" ResizeDirection="Columns" />

            <!-- 右側邊欄：屬性快速資訊 (階段三為預覽/摘要面板，階段四將擴充完整 Inspector) -->
            <Border Grid.Column="4" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,0,0" Padding="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="🔍 控制項屬性摘要" FontWeight="Bold" FontSize="14" />
                    
                    <Border Background="#27272A" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="選取節點資訊" FontWeight="SemiBold" FontSize="12" Foreground="#A1A1AA" />
                            <TextBlock Text="{Binding Canvas.SelectedNode.Name, StringFormat='名稱: {0}'}" />
                            <TextBlock Text="{Binding Canvas.SelectedNode.Type, StringFormat='型別: {0}'}" />
                            <TextBlock Text="{Binding Canvas.SelectedNode.CanvasLeft, StringFormat='X (Left): {0:F1}'}" />
                            <TextBlock Text="{Binding Canvas.SelectedNode.CanvasTop, StringFormat='Y (Top): {0:F1}'}" />
                            <TextBlock Text="{Binding Canvas.SelectedNode.Width, StringFormat='寬度 (Width): {0:F1}'}" />
                            <TextBlock Text="{Binding Canvas.SelectedNode.Height, StringFormat='高度 (Height): {0:F1}'}" />
                        </StackPanel>
                    </Border>

                    <Border Background="#27272A" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="畫布設定" FontWeight="SemiBold" FontSize="12" Foreground="#A1A1AA" />
                            <TextBlock Text="{Binding Canvas.Document.ViewClassName, StringFormat='View: {0}'}" />
                            <TextBlock Text="{Binding Canvas.Document.ViewModelClassName, StringFormat='ViewModel: {0}'}" />
                            <TextBlock Text="{Binding Canvas.Document.CanvasWidth, StringFormat='畫布寬度: {0} px'}" />
                            <TextBlock Text="{Binding Canvas.Document.CanvasHeight, StringFormat='畫布高度: {0} px'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部狀態列 (Status Bar) -->
        <Border Grid.Row="2"
                Background="#09090B"
                BorderBrush="#27272A"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Canvas.SelectedNode.Id, StringFormat='目前選取: {0}'}"
                           FontSize="11"
                           Foreground="#71717A" />
                <TextBlock Grid.Column="2"
                           Text="Avalonia Form Generator (AFG) - C# Markup Mode"
                           FontSize="11"
                           Foreground="#71717A" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
