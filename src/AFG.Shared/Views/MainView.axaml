<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AFG.Shared.ViewModels"
             xmlns:views="using:AFG.Shared.Views"
             xmlns:controls="using:AFG.Shared.Controls"
             xmlns:models="using:AFG.Shared.Models"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="AFG.Shared.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportFullProjectCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- 頂部選單列 (Menu Bar) -->
        <Border Grid.Row="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1">
            <Menu Background="#18181B">
                <MenuItem Header="檔案(_F)">
                    <MenuItem Header="新增表單" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                    <MenuItem Header="開啟專案..." Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                    <MenuItem Header="儲存專案..." Command="{Binding SaveDocumentCommand}" InputGesture="Ctrl+S" />
                    <Separator />
                    <MenuItem Header="匯出完整跨平台專案..." Command="{Binding ExportFullProjectCommand}" InputGesture="Ctrl+Shift+E" />
                </MenuItem>
                <MenuItem Header="編輯(_E)">
                    <MenuItem Header="復原" Command="{Binding UndoCommand}" IsEnabled="{Binding Canvas.History.CanUndo}" InputGesture="Ctrl+Z" />
                    <MenuItem Header="重做" Command="{Binding RedoCommand}" IsEnabled="{Binding Canvas.History.CanRedo}" InputGesture="Ctrl+Y" />
                    <Separator />
                    <MenuItem Header="複製節點" Command="{Binding CopyNodesCommand}" InputGesture="Ctrl+C" />
                    <MenuItem Header="貼上節點" Command="{Binding PasteNodesCommand}" InputGesture="Ctrl+V" />
                    <MenuItem Header="刪除選取" Command="{Binding DeleteSelectedNodeCommand}" InputGesture="Delete" />
                </MenuItem>
                <MenuItem Header="排版對齊(_A)">
                    <MenuItem Header="靠左對齊" Command="{Binding AlignLeftCommand}" />
                    <MenuItem Header="水平置中" Command="{Binding AlignCenterCommand}" />
                    <MenuItem Header="靠右對齊" Command="{Binding AlignRightCommand}" />
                    <Separator />
                    <MenuItem Header="頂部對齊" Command="{Binding AlignTopCommand}" />
                    <MenuItem Header="垂直置中" Command="{Binding AlignMiddleCommand}" />
                    <MenuItem Header="底部對齊" Command="{Binding AlignBottomCommand}" />
                    <Separator />
                    <MenuItem Header="水平均勻分佈" Command="{Binding DistributeHorizontalCommand}" />
                    <MenuItem Header="垂直均勻分佈" Command="{Binding DistributeVerticalCommand}" />
                </MenuItem>
                <MenuItem Header="檢視(_V)">
                    <MenuItem Header="工具箱 / 元件樹" Command="{Binding ToggleLeftPanelCommand}" />
                    <MenuItem Header="即時程式碼預覽" Command="{Binding ToggleCodePanelCommand}" />
                    <MenuItem Header="屬性檢查器" Command="{Binding ToggleRightPanelCommand}" />
                    <Separator />
                    <MenuItem Header="複製 View C# Markup" Command="{Binding CopyViewCodeCommand}" />
                    <MenuItem Header="複製 ViewModel C#" Command="{Binding CopyVmCodeCommand}" />
                </MenuItem>
                <MenuItem Header="裝置與規格(_D)">
                    <MenuItem Header="桌面端解析度">
                        <MenuItem Header="Desktop 1080p (1920x1080, 16:9)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="1920x1080" />
                        <MenuItem Header="Desktop 720p (1280x720, 16:9)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="1280x720" />
                        <MenuItem Header="Desktop Standard (800x600, 4:3)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="800x600" />
                        <MenuItem Header="Desktop Small (960x600, 16:10)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="960x600" />
                    </MenuItem>
                    <MenuItem Header="行動手機解析度">
                        <MenuItem Header="Phone 9:19.5 (390x844, Modern Flagship)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="390x844" />
                        <MenuItem Header="Phone 9:20 (412x915, Android Standard)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="412x915" />
                        <MenuItem Header="Phone 9:16 (360x640, Classic Mobile)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="360x640" />
                        <MenuItem Header="Phone FHD+ 9:20 (1080x2400)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="1080x2400" />
                    </MenuItem>
                    <MenuItem Header="平板電腦解析度">
                        <MenuItem Header="Tablet 3:4 (768x1024, iPad Standard)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="768x1024" />
                        <MenuItem Header="Tablet 16:10 (800x1280)" Command="{Binding Canvas.SetCanvasSizeCommand}" CommandParameter="800x1280" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="自訂解析度..."
                              Command="{Binding OpenCustomResolutionDialogCommand}" />
                    <Separator />
                    <MenuItem Header="網格吸附 (Snap to Grid)"
                              ToggleType="CheckBox"
                              IsChecked="{Binding Canvas.SnapToGrid, Mode=TwoWay}" />
                </MenuItem>
                <MenuItem Header="專案與架構(_P)">
                    <MenuItem Header="包含行動端專案 (.Android)"
                              ToggleType="CheckBox"
                              IsChecked="{Binding Canvas.IncludeMobileProject, Mode=TwoWay}" />
                    <MenuItem Header="包含授權文件 (LICENSE)"
                              ToggleType="CheckBox"
                              IsChecked="{Binding Canvas.IncludeLicense, Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="使用強型別編譯綁定 (Compiled Bindings)"
                              ToggleType="CheckBox"
                              IsChecked="{Binding Canvas.UseCompiledBindings, Mode=TwoWay}" />
                    <MenuItem Header="啟用相依性注入架構 (Dependency Injection)"
                              ToggleType="CheckBox"
                              IsChecked="{Binding Canvas.EnableDependencyInjection, Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="匯出完整跨平台專案..."
                              Command="{Binding ExportFullProjectCommand}"
                              InputGesture="Ctrl+Shift+E" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 中間主工作區（支援左側、底部、右側面板摺疊展開） -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, *, Auto, Auto">
            <!-- 左側邊欄：工具箱與 DOM 樹 -->
            <Border Grid.Column="0"
                    Width="260"
                    IsVisible="{Binding IsLeftPanelVisible}"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="0,0,1,0">
                <TabControl>
                    <TabItem Header="工具箱">
                        <views:ToolboxView DataContext="{Binding Toolbox}" />
                    </TabItem>
                    <TabItem Header="元件樹">
                        <views:VisualTreeExplorerView DataContext="{Binding VisualTree}" />
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          IsVisible="{Binding IsLeftPanelVisible}"
                          Background="#27272A"
                          ResizeDirection="Columns" />

            <!-- 中央區塊：設計畫布與即時程式碼預覽 -->
            <Grid Grid.Column="2" x:Name="CenterGrid" RowDefinitions="*, Auto, Auto">
                <!-- 視覺畫布區 (ScrollViewer) -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#09090B">
                    <Border Margin="24"
                            BoxShadow="0 10 30 0 #40000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="#3F3F46"
                            BorderThickness="1">
                        <controls:DesignCanvas x:Name="MainDesignCanvas"
                                               Width="{Binding Canvas.Document.CanvasWidth}"
                                               Height="{Binding Canvas.Document.CanvasHeight}"
                                               ViewModel="{Binding Canvas}" />
                    </Border>
                </ScrollViewer>

                <GridSplitter Grid.Row="1"
                              Height="4"
                              IsVisible="{Binding IsCodePanelVisible}"
                              Background="#27272A"
                              ResizeDirection="Rows" />

                <!-- 底部即時程式碼預覽區 -->
                <Border Grid.Row="2"
                        Height="240"
                        IsVisible="{Binding IsCodePanelVisible}"
                        Background="#18181B"
                        BorderBrush="#27272A"
                        BorderThickness="0,1,0,0">
                    <TabControl>
                        <TabItem Header="View (C# Markup)">
                            <Grid RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,4">
                                    <Button Content="複製 View 程式碼"
                                            Command="{Binding CopyViewCodeCommand}"
                                            Padding="10,4"
                                            FontSize="11"
                                            Background="#27272A"
                                            Foreground="#E4E4E7" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="#121214"
                                              Padding="12,8">
                                    <SelectableTextBlock x:Name="ViewCodeTextBlock"
                                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                                         FontSize="12"
                                                         LineHeight="20"
                                                         Foreground="#D4D4D4" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="ViewModel (CommunityToolkit.Mvvm)">
                            <Grid RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,4">
                                    <Button Content="複製 ViewModel 程式碼"
                                            Command="{Binding CopyVmCodeCommand}"
                                            Padding="10,4"
                                            FontSize="11"
                                            Background="#27272A"
                                            Foreground="#E4E4E7" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="#121214"
                                              Padding="12,8">
                                    <SelectableTextBlock x:Name="VmCodeTextBlock"
                                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                                         FontSize="12"
                                                         LineHeight="20"
                                                         Foreground="#D4D4D4" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          IsVisible="{Binding IsRightPanelVisible}"
                          Background="#27272A"
                          ResizeDirection="Columns" />

            <!-- 右側邊欄：完整屬性與事件檢查器 (Inspector) -->
            <Border Grid.Column="4"
                    Width="320"
                    IsVisible="{Binding IsRightPanelVisible}"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1,0,0,0">
                <views:InspectorView DataContext="{Binding Inspector}" />
            </Border>
        </Grid>

        <!-- 底部狀態列 (Status Bar) -->
        <Border Grid.Row="2"
                Background="#09090B"
                BorderBrush="#27272A"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding Canvas.SelectedNode.Id, StringFormat='選取節點: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                    <TextBlock Text="{Binding ValidationErrorCount, StringFormat='問題: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                    <TextBlock Text="{Binding Canvas.SelectedPreset.Name, StringFormat='規格: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                    <TextBlock Text="{Binding Canvas.CanvasWidth, StringFormat='寬: {0:0}px'}"
                               FontSize="11"
                               Foreground="#71717A" />
                    <TextBlock Text="{Binding Canvas.CanvasHeight, StringFormat='高: {0:0}px'}"
                               FontSize="11"
                               Foreground="#71717A" />
                    <TextBlock Text="{Binding Canvas.ExportProjectName, StringFormat='專案: {0}'}"
                               FontSize="11"
                               Foreground="#71717A" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Avalonia Form Generator (AFG) - Pure C# Declarative UI Engine (.NET 10)"
                           FontSize="11"
                           Foreground="#71717A" />
            </Grid>
        </Border>

        <!-- 自訂解析度對話框遮罩 (Custom Resolution Modal Dialog) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                IsVisible="{Binding IsCustomResolutionDialogVisible}"
                Background="#80000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="999">
            <Border Background="#1E1E24"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="340"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #80000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="自訂畫布解析度" FontSize="15" FontWeight="Bold" Foreground="#F4F4F5" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="寬度 (Width px):" FontSize="11" Foreground="#A1A1AA" />
                        <NumericUpDown Value="{Binding CustomResolutionWidth, Mode=TwoWay}"
                                       Minimum="200" Maximum="4000"
                                       FormatString="0" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="高度 (Height px):" FontSize="11" Foreground="#A1A1AA" />
                        <NumericUpDown Value="{Binding CustomResolutionHeight, Mode=TwoWay}"
                                       Minimum="200" Maximum="4000"
                                       FormatString="0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="取消"
                                Command="{Binding CloseCustomResolutionDialogCommand}"
                                Width="80"
                                HorizontalContentAlignment="Center"
                                Background="#27272A" />
                        <Button Content="套用"
                                Command="{Binding ApplyCustomResolutionCommand}"
                                Width="80"
                                HorizontalContentAlignment="Center"
                                Background="#2563EB"
                                Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
