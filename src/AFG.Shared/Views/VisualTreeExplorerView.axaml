<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AFG.Shared.ViewModels"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="500"
             x:Class="AFG.Shared.Views.VisualTreeExplorerView"
             x:DataType="vm:VisualTreeViewModel">

    <Grid RowDefinitions="Auto, *">
        <TextBlock Grid.Row="0"
                   Text="DOM 元件階層樹"
                   FontWeight="Bold"
                   FontSize="13"
                   Margin="8,8,8,6" />

        <TreeView Grid.Row="1"
                  ItemsSource="{Binding Root.Children}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  Background="Transparent"
                  Margin="4">
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <Border Background="#3F3F46" CornerRadius="3" Padding="3,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconGlyph}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
