<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AFG.Shared.ViewModels"
             xmlns:views="using:AFG.Shared.Views"
             xmlns:models="using:AFG.Core.Models.Ast"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="700"
             x:Class="AFG.Shared.Views.InspectorView"
             x:DataType="vm:InspectorViewModel">

    <Grid Background="#18181B">
        <!-- 1. 表單 / 視窗屬性編輯面板 (未選取子控制項或切換至表單時顯示) -->
        <Grid IsVisible="{Binding IsFormSelected}" RowDefinitions="Auto, *">
            <!-- 標頭：表單與視窗 -->
            <Border Grid.Row="0"
                    Background="#27272A"
                    Padding="10,8"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="表單與視窗屬性 (Form)"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#38BDF8" />
                        <TextBlock Text="配置主視窗標題、背景顏色與視窗行為"
                                   FontSize="10"
                                   Foreground="#71717A" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 表單屬性分頁 -->
            <TabControl Grid.Row="1" Margin="4,0,4,4">
                <!-- 分頁 1: 外觀與標題 -->
                <TabItem Header="外觀">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="6">
                            <!-- 視窗標題 (Title) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="視窗標題 (Title)" FontSize="11" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding FormTitle, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 表單背景顏色 (BackgroundColor) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="表單背景顏色 (BackgroundColor)" FontSize="11" Foreground="#A1A1AA" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Text="{Binding FormBackgroundColor, Mode=TwoWay}"
                                             PlaceholderText="#FFFFFF 或 Transparent" />
                                    <Border Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            Margin="6,0,0,0"
                                            CornerRadius="4"
                                            BorderBrush="#52525B"
                                            BorderThickness="1"
                                            Background="{Binding FormBackgroundColor}" />
                                </Grid>
                                <!-- 快捷常用色票按鈕 -->
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="純白" Command="{Binding SetFormBackgroundColorCommand}" CommandParameter="#FFFFFF" Padding="6,2" Margin="2" FontSize="10" />
                                    <Button Content="淺灰" Command="{Binding SetFormBackgroundColorCommand}" CommandParameter="#F3F4F6" Padding="6,2" Margin="2" FontSize="10" />
                                    <Button Content="米色" Command="{Binding SetFormBackgroundColorCommand}" CommandParameter="#FEF3C7" Padding="6,2" Margin="2" FontSize="10" />
                                    <Button Content="深灰" Command="{Binding SetFormBackgroundColorCommand}" CommandParameter="#27272A" Padding="6,2" Margin="2" FontSize="10" />
                                    <Button Content="夜黑" Command="{Binding SetFormBackgroundColorCommand}" CommandParameter="#18181B" Padding="6,2" Margin="2" FontSize="10" />
                                    <Button Content="暗藍" Command="{Binding SetFormBackgroundColorCommand}" CommandParameter="#0F172A" Padding="6,2" Margin="2" FontSize="10" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- 視窗圖示 (Icon) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="視窗圖示 (Icon)" FontSize="11" Foreground="#A1A1AA" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Text="{Binding FormIcon, Mode=TwoWay}"
                                             PlaceholderText="圖示路徑 (.ico / .png)" />
                                    <Button Grid.Column="1"
                                            Content="瀏覽..."
                                            Command="{Binding BrowseFormIconCommand}"
                                            Margin="4,0,0,0"
                                            Padding="8,4"
                                            FontSize="11" />
                                </Grid>
                            </StackPanel>

                            <!-- 類別名稱與命名空間 -->
                            <Border Background="#27272A" CornerRadius="4" Padding="8" Margin="0,6,0,0">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="專案與類別架構" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="View 類別名稱" FontSize="10" Foreground="#71717A" />
                                        <TextBox Text="{Binding FormViewClassName, Mode=TwoWay}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="ViewModel 類別名稱" FontSize="10" Foreground="#71717A" />
                                        <TextBox Text="{Binding FormViewModelClassName, Mode=TwoWay}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="目標語言 (Target Language)" FontSize="10" Foreground="#71717A" />
                                        <ComboBox ItemsSource="{Binding TargetLanguageOptions}"
                                                  SelectedItem="{Binding FormTargetLanguage, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="命名空間 (RootNamespace)" FontSize="10" Foreground="#71717A" />
                                        <TextBox Text="{Binding FormRootNamespace, Mode=TwoWay}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 分頁 2: 尺寸與版面 -->
                <TabItem Header="尺寸">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="6">
                            <!-- 預設畫布寬高 -->
                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                    <TextBlock Text="寬度 (Width)" FontSize="11" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding FormWidth, Mode=TwoWay}" Minimum="100" Maximum="7680" Increment="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                    <TextBlock Text="高度 (Height)" FontSize="11" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding FormHeight, Mode=TwoWay}" Minimum="100" Maximum="4320" Increment="10" />
                                </StackPanel>
                            </Grid>

                            <!-- 常用解析度快速設定 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="快速切換解析度" FontSize="11" Foreground="#A1A1AA" />
                                <WrapPanel>
                                    <Button Content="800x600" Command="{Binding ApplyFormPresetCommand}" CommandParameter="800x600" Padding="6,2" Margin="2" FontSize="10" />
                                    <Button Content="1024x768" Command="{Binding ApplyFormPresetCommand}" CommandParameter="1024x768" Padding="6,2" Margin="2" FontSize="10" />
                                    <Button Content="1280x720" Command="{Binding ApplyFormPresetCommand}" CommandParameter="1280x720" Padding="6,2" Margin="2" FontSize="10" />
                                    <Button Content="1920x1080" Command="{Binding ApplyFormPresetCommand}" CommandParameter="1920x1080" Padding="6,2" Margin="2" FontSize="10" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- 最小與最大寬度高度限制 -->
                            <Border Background="#27272A" CornerRadius="4" Padding="8" Margin="0,6,0,0">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="視窗尺寸極限約束 (可選)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,4,4">
                                            <TextBlock Text="最小寬度 (MinWidth)" FontSize="10" Foreground="#71717A" />
                                            <NumericUpDown Value="{Binding FormMinWidth, Mode=TwoWay}" Minimum="0" Maximum="7680" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="4,0,0,4">
                                            <TextBlock Text="最小高度 (MinHeight)" FontSize="10" Foreground="#71717A" />
                                            <NumericUpDown Value="{Binding FormMinHeight, Mode=TwoWay}" Minimum="0" Maximum="4320" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,4,4,0">
                                            <TextBlock Text="最大寬度 (MaxWidth)" FontSize="10" Foreground="#71717A" />
                                            <NumericUpDown Value="{Binding FormMaxWidth, Mode=TwoWay}" Minimum="0" Maximum="7680" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="4,4,0,0">
                                            <TextBlock Text="最大高度 (MaxHeight)" FontSize="10" Foreground="#71717A" />
                                            <NumericUpDown Value="{Binding FormMaxHeight, Mode=TwoWay}" Minimum="0" Maximum="4320" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 分頁 3: 視窗行為 -->
                <TabItem Header="行為">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="6">
                            <!-- 啟動位置 (WindowStartupLocation) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="視窗啟動位置 (WindowStartupLocation)" FontSize="11" Foreground="#A1A1AA" />
                                <ComboBox ItemsSource="{Binding WindowStartupLocationOptions}"
                                          SelectedItem="{Binding FormWindowStartupLocation, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- 視窗狀態 (WindowState) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="初始視窗狀態 (WindowState)" FontSize="11" Foreground="#A1A1AA" />
                                <ComboBox ItemsSource="{Binding WindowStateOptions}"
                                          SelectedItem="{Binding FormWindowState, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- 系統邊框裝飾 (SystemDecorations) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="系統裝飾樣式 (SystemDecorations)" FontSize="11" Foreground="#A1A1AA" />
                                <ComboBox ItemsSource="{Binding SystemDecorationsOptions}"
                                          SelectedItem="{Binding FormSystemDecorations, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Border Height="1" Background="#3F3F46" Margin="0,4" />

                            <!-- 開關選項 -->
                            <CheckBox Content="允許調整大小 (CanResize)"
                                      IsChecked="{Binding FormCanResize, Mode=TwoWay}" />
                            <CheckBox Content="視窗永遠置頂 (Topmost)"
                                      IsChecked="{Binding FormTopmost, Mode=TwoWay}" />
                            <CheckBox Content="在工作列顯示 (ShowInTaskbar)"
                                      IsChecked="{Binding FormShowInTaskbar, Mode=TwoWay}" />

                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <TextBlock Text="代碼架構模式 (Architecture Mode)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding ArchitectureModeOptions}"
                                          SelectedItem="{Binding FormArchitectureMode, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 分頁 4: 表單事件 (Form Events) -->
                <TabItem Header="事件">
                    <Grid RowDefinitions="Auto, *">
                        <Button Grid.Row="0"
                                Command="{Binding AddFormEventCommand}"
                                Margin="4,6,4,6"
                                Content="新增表單事件命令"
                                HorizontalAlignment="Stretch" />

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding FormEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventItemViewModel">
                                        <Border Background="#27272A" CornerRadius="6" Padding="8" Margin="0,3">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="表單事件命令映射" FontWeight="SemiBold" FontSize="12" Foreground="#F59E0B" />
                                                    <Button Grid.Column="1"
                                                            Content="刪除"
                                                            Padding="6,2"
                                                            FontSize="10"
                                                            Command="{Binding $parent[views:InspectorView].((vm:InspectorViewModel)DataContext).RemoveFormEventCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="事件名稱 (EventName)" FontSize="10" Foreground="#A1A1AA" />
                                                    <ComboBox ItemsSource="{Binding AvailableEvents}"
                                                              SelectedItem="{Binding EventName, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch" />
                                                </StackPanel>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="ViewModel Command 名稱" FontSize="10" Foreground="#A1A1AA" />
                                                    <TextBox Text="{Binding CommandProperty, Mode=TwoWay}" />
                                                </StackPanel>

                                                <!-- 多參數清單區塊 -->
                                                <Border Background="#18181B" CornerRadius="4" Padding="6" Margin="0,2">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Grid.Column="0" Text="方法參數清單 (Parameters)" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="新增參數"
                                                                    Padding="6,2"
                                                                    FontSize="10"
                                                                    Command="{Binding AddParameterCommand}" />
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding Parameters}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:EventParameterItemViewModel">
                                                                    <Border Background="#27272A" CornerRadius="4" Padding="6" Margin="0,2">
                                                                        <StackPanel Spacing="4">
                                                                            <Grid ColumnDefinitions="*, Auto">
                                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" />
                                                                                <Button Grid.Column="1"
                                                                                        Content="刪除"
                                                                                        Padding="4,1"
                                                                                        FontSize="9"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:EventItemViewModel)DataContext).RemoveParameterCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </Grid>

                                                                            <Grid ColumnDefinitions="*, *">
                                                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,2,0">
                                                                                    <TextBlock Text="參數名稱" FontSize="9" Foreground="#A1A1AA" />
                                                                                    <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="1" Spacing="2" Margin="2,0,0,0">
                                                                                    <TextBlock Text="型別 (Type)" FontSize="9" Foreground="#A1A1AA" />
                                                                                    <ComboBox ItemsSource="{Binding AvailableParameterTypes}"
                                                                                              SelectedItem="{Binding Type, Mode=TwoWay}"
                                                                                              FontSize="11"
                                                                                              HorizontalAlignment="Stretch" />
                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Text="綁定路徑/常數值 (選填)" FontSize="9" Foreground="#A1A1AA" />
                                                                                <TextBox Text="{Binding ValueOrPath, Mode=TwoWay}"
                                                                                         PlaceholderText="原生事件傳遞或指定屬性"
                                                                                         FontSize="11" />
                                                                            </StackPanel>

                                                                            <CheckBox IsChecked="{Binding IsConstant, Mode=TwoWay}"
                                                                                      Content="靜態常數值"
                                                                                      FontSize="10" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <CheckBox IsChecked="{Binding IsAsync, Mode=TwoWay}"
                                                          Content="非同步命令 (Async RelayCommand)"
                                                          FontSize="11"
                                                          Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 2. 已選取子節點之屬性與事件編輯面板 -->
        <Grid IsVisible="{Binding !IsFormSelected}" RowDefinitions="Auto, *">
            <!-- 標頭：控制項類型與識別碼 -->
            <Border Grid.Row="0"
                    Background="#27272A"
                    Padding="10,8"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding ControlType}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#38BDF8" />
                        <TextBlock Text="{Binding NodeId, StringFormat='ID: {0}'}"
                                   FontSize="10"
                                   Foreground="#71717A" />
                    </StackPanel>

                    <!-- 切換回表單屬性按鈕 -->
                    <Button Grid.Column="1"
                            Content="表單屬性"
                            Command="{Binding SelectFormCommand}"
                            Padding="6,3"
                            FontSize="10"
                            Margin="0,0,6,0"
                            Background="#3F3F46"
                            Foreground="#E4E4E7" />

                    <!-- 驗證警示徽章 -->
                    <Border Grid.Column="2"
                            IsVisible="{Binding ValidationErrors.Count}"
                            Background="#DC2626"
                            CornerRadius="10"
                            Padding="6,2">
                        <TextBlock Text="{Binding ValidationErrors.Count, StringFormat='問題: {0}'}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- 屬性分頁 -->
            <TabControl Grid.Row="1" Margin="4,0,4,4">
                <!-- 分頁 1: 外觀與文字 -->
                <TabItem Header="外觀">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="6">
                            <StackPanel Spacing="4">
                                <TextBlock Text="控制項名稱 (x:Name)" FontSize="11" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding NodeName, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 內容 / 標籤 (Content) - 僅適用於 ContentControl -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsContentSupported}">
                                <TextBlock Text="內容 / 標籤 (Content)" FontSize="11" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding Content, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 文字 (Text) - 僅適用於支援文字之控制項 -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsTextSupported}">
                                <TextBlock Text="文字 (Text)" FontSize="11" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding Text, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 標題 (Header) - 僅適用於 HeaderedContentControl -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsHeaderSupported}">
                                <TextBlock Text="標題 (Header)" FontSize="11" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding Header, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 提示文字 (Watermark) - 僅適用於 TextBox 等輸入項 -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsWatermarkSupported}">
                                <TextBlock Text="提示文字 (Watermark)" FontSize="11" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding Watermark, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 計時器間隔 (Interval ms) - 僅適用於 DispatcherTimer -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsTimerSupported}">
                                <TextBlock Text="觸發間隔 (Interval 毫秒)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                <NumericUpDown Value="{Binding Interval, Mode=TwoWay}" Minimum="1" Maximum="86400000" Increment="100" />
                            </StackPanel>

                            <!-- 影像來源 (Source) 與瀏覽選擇 - 僅適用於 PictureBox / Image -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsImageSupported}">
                                <TextBlock Text="影像來源 (Source / ImageLocation)" FontSize="11" Foreground="#A1A1AA" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Text="{Binding Source, Mode=TwoWay}"
                                             PlaceholderText="輸入路徑、點擊右側瀏覽或 URL" />
                                    <Button Grid.Column="1"
                                            Content="瀏覽..."
                                            Command="{Binding BrowseImageCommand}"
                                            Margin="4,0,0,0"
                                            Padding="8,4"
                                            FontSize="11" />
                                </Grid>
                            </StackPanel>

                            <!-- 即時圖片資訊與預覽卡片 -->
                            <Border Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    IsVisible="{Binding HasImageSource}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="已選取影像檔案：" FontSize="10" Foreground="#71717A" />
                                    <TextBlock Text="{Binding ImageFileInfo}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#38BDF8"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 路徑模式選項 (相對路徑 / 絕對路徑) -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsImageSupported}">
                                <CheckBox Content="使用專案相對路徑 (匯出時自動複製至 Assets)"
                                          IsChecked="{Binding UseRelativePath, Mode=TwoWay}"
                                          FontSize="11" />
                            </StackPanel>

                            <!-- 縮放模式 (Stretch) - 僅適用於 PictureBox / Image -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsImageSupported}">
                                <TextBlock Text="縮放模式 (Stretch / SizeMode)" FontSize="11" Foreground="#A1A1AA" />
                                <ComboBox ItemsSource="{Binding StretchOptions}"
                                          SelectedItem="{Binding Stretch, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- 初始化空白 Bitmap (Init Bitmap) -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsImageSupported}">
                                <CheckBox Content="初始化空白點陣圖 (Init Bitmap)"
                                          IsChecked="{Binding InitBitmap, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          FontSize="11"
                                          Foreground="#A78BFA" />
                                <StackPanel Spacing="4" IsVisible="{Binding InitBitmap}">
                                    <TextBlock Text="Bitmap 背景顏色 (預設 #F0F0F0)" FontSize="10" Foreground="#A1A1AA" />
                                    <TextBox Text="{Binding BitmapBackgroundColor, Mode=TwoWay}"
                                             PlaceholderText="#F0F0F0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 多媒體播放器專屬設定 (MediaPlayerControl Properties) -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsMediaPlayerSupported}">
                                <TextBlock Text="媒體來源 (URL / 本地檔案路徑)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Source, Mode=TwoWay}"
                                         PlaceholderText="https://... 或 avares:// 或 本地路徑" />

                                <Grid ColumnDefinitions="*, *" Margin="0,2">
                                    <CheckBox Grid.Column="0" Content="自動播放 (AutoPlay)" IsChecked="{Binding AutoPlay, Mode=TwoWay}" FontSize="11" />
                                    <CheckBox Grid.Column="1" Content="循環播放 (IsLooping)" IsChecked="{Binding IsLooping, Mode=TwoWay}" FontSize="11" />
                                </Grid>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Volume, StringFormat='音量 (Volume): {0:P0}'}" FontSize="11" Foreground="#A1A1AA" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="縮放模式 (Stretch)" FontSize="11" Foreground="#A1A1AA" />
                                    <ComboBox ItemsSource="{Binding StretchOptions}"
                                              SelectedItem="{Binding Stretch, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 選取狀態 (IsChecked) - 僅適用於 CheckBox / RadioButton -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsCheckableSupported}">
                                <CheckBox Content="選中狀態 (IsChecked)" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 數值 (Value) - 僅適用於 Slider / ProgressBar -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsValueSupported}">
                                <TextBlock Text="數值 (Value)" FontSize="11" Foreground="#A1A1AA" />
                                <NumericUpDown Value="{Binding Value, Mode=TwoWay}" Minimum="0" Maximum="1000" />
                            </StackPanel>

                            <!-- 自動調整尺寸 (AutoSize) -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsAutoSizeSupported}">
                                <CheckBox Content="自動依文字調整尺寸 (AutoSize)" IsChecked="{Binding AutoSize, Mode=TwoWay}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*, *" Margin="0,4" IsVisible="{Binding IsVisualControl}">
                                <CheckBox Grid.Column="0" Content="啟用 (IsEnabled)" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                <CheckBox Grid.Column="1" Content="可見 (IsVisible)" IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                            </Grid>

                            <!-- 顏色配置 -->
                            <Grid ColumnDefinitions="*, *" Margin="0,2" IsVisible="{Binding IsVisualControl}">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                                    <TextBlock Text="背景色 (Background)" FontSize="11" Foreground="#A1A1AA" />
                                    <TextBox Text="{Binding Background, Mode=TwoWay}" PlaceholderText="#RRGGBB 或顏色名" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                                    <TextBlock Text="前景色 (Foreground)" FontSize="11" Foreground="#A1A1AA" />
                                    <TextBox Text="{Binding Foreground, Mode=TwoWay}" PlaceholderText="#RRGGBB 或顏色名" />
                                </StackPanel>
                            </Grid>

                            <!-- 字體大小 -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsTextSupported}">
                                <TextBlock Text="字體大小 (FontSize)" FontSize="11" Foreground="#A1A1AA" />
                                <NumericUpDown Value="{Binding FontSize, Mode=TwoWay}" Minimum="6" Maximum="120" />
                            </StackPanel>

                            <!-- 不透明度 -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsVisualControl}">
                                <TextBlock Text="{Binding Opacity, StringFormat='不透明度: {0:P0}'}" FontSize="11" Foreground="#A1A1AA" />
                                <Slider Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 邊框與圓角配置 -->
                            <Border Background="#27272A" CornerRadius="6" Padding="8" Margin="0,4" IsVisible="{Binding IsVisualControl}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="邊框與圓角 (Border &amp; CornerRadius)" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="邊框顏色 (BorderBrush)" FontSize="10" Foreground="#A1A1AA" />
                                        <TextBox Text="{Binding BorderBrush, Mode=TwoWay}" PlaceholderText="#RRGGBB 或顏色名" />
                                    </StackPanel>

                                    <!-- 邊框粗細 (L, T, R, B) -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="邊框粗細 (BorderThickness: 左, 上, 右, 下)" FontSize="10" Foreground="#A1A1AA" />
                                        <Grid ColumnDefinitions="*, *, *, *">
                                            <NumericUpDown Grid.Column="0" Margin="0,0,2,0" Value="{Binding BorderThicknessLeft, Mode=TwoWay}" Minimum="0" Maximum="100" />
                                            <NumericUpDown Grid.Column="1" Margin="2,0,2,0" Value="{Binding BorderThicknessTop, Mode=TwoWay}" Minimum="0" Maximum="100" />
                                            <NumericUpDown Grid.Column="2" Margin="2,0,2,0" Value="{Binding BorderThicknessRight, Mode=TwoWay}" Minimum="0" Maximum="100" />
                                            <NumericUpDown Grid.Column="3" Margin="2,0,0,0" Value="{Binding BorderThicknessBottom, Mode=TwoWay}" Minimum="0" Maximum="100" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- 圓角半徑 (TL, TR, BR, BL) -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="圓角半徑 (CornerRadius: 左上, 右上, 右下, 左下)" FontSize="10" Foreground="#A1A1AA" />
                                        <Grid ColumnDefinitions="*, *, *, *">
                                            <NumericUpDown Grid.Column="0" Margin="0,0,2,0" Value="{Binding CornerRadiusTopLeft, Mode=TwoWay}" Minimum="0" Maximum="200" />
                                            <NumericUpDown Grid.Column="1" Margin="2,0,2,0" Value="{Binding CornerRadiusTopRight, Mode=TwoWay}" Minimum="0" Maximum="200" />
                                            <NumericUpDown Grid.Column="2" Margin="2,0,2,0" Value="{Binding CornerRadiusBottomRight, Mode=TwoWay}" Minimum="0" Maximum="200" />
                                            <NumericUpDown Grid.Column="3" Margin="2,0,0,0" Value="{Binding CornerRadiusBottomLeft, Mode=TwoWay}" Minimum="0" Maximum="200" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 陰影效果配置 (BoxShadow / DropShadow) -->
                            <Border Background="#27272A" CornerRadius="6" Padding="8" Margin="0,4" IsVisible="{Binding IsVisualControl}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="陰影效果 (BoxShadow / DropShadow)" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding HasBoxShadow, Mode=TwoWay}" OnContent="開" OffContent="關" />
                                    </Grid>

                                    <StackPanel Spacing="6" IsVisible="{Binding HasBoxShadow}">
                                        <!-- X / Y 偏移 -->
                                        <Grid ColumnDefinitions="*, *">
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                                                <TextBlock Text="水平位移 (OffsetX)" FontSize="10" Foreground="#A1A1AA" />
                                                <NumericUpDown Value="{Binding BoxShadowOffsetX, Mode=TwoWay}" Minimum="-200" Maximum="200" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                                                <TextBlock Text="垂直位移 (OffsetY)" FontSize="10" Foreground="#A1A1AA" />
                                                <NumericUpDown Value="{Binding BoxShadowOffsetY, Mode=TwoWay}" Minimum="-200" Maximum="200" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 模糊 / 擴展 -->
                                        <Grid ColumnDefinitions="*, *">
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                                                <TextBlock Text="模糊半徑 (Blur)" FontSize="10" Foreground="#A1A1AA" />
                                                <NumericUpDown Value="{Binding BoxShadowBlur, Mode=TwoWay}" Minimum="0" Maximum="200" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                                                <TextBlock Text="擴展半徑 (Spread)" FontSize="10" Foreground="#A1A1AA" />
                                                <NumericUpDown Value="{Binding BoxShadowSpread, Mode=TwoWay}" Minimum="-100" Maximum="100" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 陰影顏色與內陰影開關 -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                                                <TextBlock Text="陰影顏色 (Color)" FontSize="10" Foreground="#A1A1AA" />
                                                <TextBox Text="{Binding BoxShadowColor, Mode=TwoWay}" PlaceholderText="#40000000" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,0,0">
                                                <CheckBox Content="內陰影 (Inset)" IsChecked="{Binding BoxShadowInset, Mode=TwoWay}" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 分頁 2: 尺寸與排版 -->
                <TabItem Header="排版" IsVisible="{Binding IsGeometrySupported}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="6">
                            <!-- 父容器自動排版提示 (Managed by Parent Layout) -->
                            <Border Background="#1E293B"
                                    BorderBrush="#0284C7"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6"
                                    IsVisible="{Binding IsPositionManagedByParent}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding ParentContainerType, StringFormat='由父容器自動排版 (Managed by {0})'}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#38BDF8" />
                                    <TextBlock Text="控制項位置由父容器規則決定，自由座標 (X, Y) 已自動停用。"
                                               FontSize="10"
                                               Foreground="#94A3B8"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 尺寸 -->
                            <Grid ColumnDefinitions="*, *" Margin="0,2">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                                    <TextBlock Text="寬度 (Width)" FontSize="11" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding Width, Mode=TwoWay}" IsEnabled="{Binding !AutoSize}" Minimum="0" Maximum="4000" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                                    <TextBlock Text="高度 (Height)" FontSize="11" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding Height, Mode=TwoWay}" IsEnabled="{Binding !AutoSize}" Minimum="0" Maximum="4000" />
                                </StackPanel>
                            </Grid>

                            <!-- Canvas 自由座標 (僅在 Canvas 或根容器下有效) -->
                            <Grid ColumnDefinitions="*, *" Margin="0,2" IsVisible="{Binding IsCanvasPositionSupported}">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                                    <TextBlock Text="座標 X (Left)" FontSize="11" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding CanvasLeft, Mode=TwoWay}" Minimum="0" Maximum="4000" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                                    <TextBlock Text="座標 Y (Top)" FontSize="11" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding CanvasTop, Mode=TwoWay}" Minimum="0" Maximum="4000" />
                                </StackPanel>
                            </Grid>

                            <!-- Grid 網格設定 (在 Grid 容器中顯式呈現) -->
                            <Grid ColumnDefinitions="*, *" Margin="0,2">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                                    <TextBlock Text="Grid 列 (Row)" FontSize="11" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding GridRow, Mode=TwoWay}" Minimum="0" Maximum="100" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                                    <TextBlock Text="Grid 欄 (Column)" FontSize="11" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding GridColumn, Mode=TwoWay}" Minimum="0" Maximum="100" />
                                </StackPanel>
                            </Grid>

                            <!-- 對齊方式 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="水平對齊 (HorizontalAlignment)" FontSize="11" Foreground="#A1A1AA" />
                                <ComboBox ItemsSource="{Binding HorizontalAlignmentOptions}"
                                          SelectedItem="{Binding HorizontalAlignment, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="垂直對齊 (VerticalAlignment)" FontSize="11" Foreground="#A1A1AA" />
                                <ComboBox ItemsSource="{Binding VerticalAlignmentOptions}"
                                          SelectedItem="{Binding VerticalAlignment, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Margin 外距 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="外距 Margin (左, 上, 右, 下)" FontSize="11" Foreground="#A1A1AA" />
                                <Grid ColumnDefinitions="*,*,*,*" Margin="0,2">
                                    <NumericUpDown Grid.Column="0" Value="{Binding MarginLeft, Mode=TwoWay}" Margin="0,0,2,0" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding MarginTop, Mode=TwoWay}" Margin="2,0,2,0" />
                                    <NumericUpDown Grid.Column="2" Value="{Binding MarginRight, Mode=TwoWay}" Margin="2,0,2,0" />
                                    <NumericUpDown Grid.Column="3" Value="{Binding MarginBottom, Mode=TwoWay}" Margin="2,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 分頁 3: MVVM 資料綁定 (Binding Builder) -->
                <TabItem Header="資料綁定">
                    <Grid RowDefinitions="Auto, *">
                        <Button Grid.Row="0"
                                Command="{Binding AddBindingCommand}"
                                Margin="4,6,4,6"
                                Content="新增資料綁定"
                                HorizontalAlignment="Stretch" />

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Bindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BindingItemViewModel">
                                        <Border Background="#27272A" CornerRadius="6" Padding="8" Margin="0,3">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="資料綁定項目" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                    <Button Grid.Column="1"
                                                            Content="刪除"
                                                            Padding="6,2"
                                                            FontSize="10"
                                                            Command="{Binding $parent[views:InspectorView].((vm:InspectorViewModel)DataContext).RemoveBindingCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="View 屬性 (TargetProperty)" FontSize="10" Foreground="#A1A1AA" />
                                                    <ComboBox ItemsSource="{Binding AvailableProperties}"
                                                              SelectedItem="{Binding TargetProperty, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch" />
                                                </StackPanel>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="ViewModel 屬性名稱" FontSize="10" Foreground="#A1A1AA" />
                                                    <TextBox Text="{Binding ViewModelProperty, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="資料型別 (C# DataType)" FontSize="10" Foreground="#A1A1AA" />
                                                    <ComboBox ItemsSource="{Binding CommonDataTypes}"
                                                              SelectedItem="{Binding CustomDataType, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch" />
                                                </StackPanel>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="綁定模式 (Mode)" FontSize="10" Foreground="#A1A1AA" />
                                                    <ComboBox ItemsSource="{Binding $parent[views:InspectorView].((vm:InspectorViewModel)DataContext).BindingModeOptions}"
                                                              SelectedItem="{Binding Mode, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- 分頁 4: 事件轉命令 (Event-to-Command) -->
                <TabItem Header="事件命令">
                    <Grid RowDefinitions="Auto, *">
                        <Button Grid.Row="0"
                                Command="{Binding AddEventCommand}"
                                Margin="4,6,4,6"
                                Content="新增事件命令"
                                HorizontalAlignment="Stretch" />

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventItemViewModel">
                                        <Border Background="#27272A" CornerRadius="6" Padding="8" Margin="0,3">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="事件命令映射" FontWeight="SemiBold" FontSize="12" Foreground="#F59E0B" />
                                                    <Button Grid.Column="1"
                                                            Content="刪除"
                                                            Padding="6,2"
                                                            FontSize="10"
                                                            Command="{Binding $parent[views:InspectorView].((vm:InspectorViewModel)DataContext).RemoveEventCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="事件名稱 (EventName)" FontSize="10" Foreground="#A1A1AA" />
                                                    <ComboBox ItemsSource="{Binding AvailableEvents}"
                                                              SelectedItem="{Binding EventName, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch" />
                                                </StackPanel>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="ViewModel Command 名稱" FontSize="10" Foreground="#A1A1AA" />
                                                    <TextBox Text="{Binding CommandProperty, Mode=TwoWay}" />
                                                </StackPanel>

                                                <!-- 多參數清單區塊 -->
                                                <Border Background="#18181B" CornerRadius="4" Padding="6" Margin="0,2">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Grid.Column="0" Text="方法參數清單 (Parameters)" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="新增參數"
                                                                    Padding="6,2"
                                                                    FontSize="10"
                                                                    Command="{Binding AddParameterCommand}" />
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding Parameters}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:EventParameterItemViewModel">
                                                                    <Border Background="#27272A" CornerRadius="4" Padding="6" Margin="0,2">
                                                                        <StackPanel Spacing="4">
                                                                            <Grid ColumnDefinitions="*, Auto">
                                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" />
                                                                                <Button Grid.Column="1"
                                                                                        Content="刪除"
                                                                                        Padding="4,1"
                                                                                        FontSize="9"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:EventItemViewModel)DataContext).RemoveParameterCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </Grid>

                                                                            <Grid ColumnDefinitions="*, *">
                                                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,2,0">
                                                                                    <TextBlock Text="參數名稱" FontSize="9" Foreground="#A1A1AA" />
                                                                                    <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="1" Spacing="2" Margin="2,0,0,0">
                                                                                    <TextBlock Text="型別 (Type)" FontSize="9" Foreground="#A1A1AA" />
                                                                                    <ComboBox ItemsSource="{Binding AvailableParameterTypes}"
                                                                                              SelectedItem="{Binding Type, Mode=TwoWay}"
                                                                                              FontSize="11"
                                                                                              HorizontalAlignment="Stretch" />
                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Text="綁定路徑/常數值 (選填)" FontSize="9" Foreground="#A1A1AA" />
                                                                                <TextBox Text="{Binding ValueOrPath, Mode=TwoWay}"
                                                                                         PlaceholderText="原生事件傳遞或指定屬性"
                                                                                         FontSize="11" />
                                                                            </StackPanel>

                                                                            <CheckBox IsChecked="{Binding IsConstant, Mode=TwoWay}"
                                                                                      Content="靜態常數值"
                                                                                      FontSize="10" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <CheckBox IsChecked="{Binding IsAsync, Mode=TwoWay}"
                                                          Content="非同步命令 (Async RelayCommand)"
                                                          FontSize="11"
                                                          Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
